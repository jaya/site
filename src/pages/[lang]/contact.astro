---
import { getLocaleParam, localeEn } from '@/i18n/utils'
import ContactPage from '../_shared/ContactPage.astro'

export function getStaticPaths() {
	return [{ params: { lang: localeEn } }]
}

const lang = getLocaleParam(Astro.params.lang, [localeEn])
if (!lang) {
	return new Response(null, { status: 404 })
}
---

<ContactPage locale={lang} />
