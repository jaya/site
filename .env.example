# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Configuration (Optional)
# If not set, defaults will be used (see src/actions/index.ts):
# EMAIL_FROM defaults to 'automation@jaya.tech'
# EMAIL_TO defaults to 'contact@jaya.tech'
EMAIL_FROM=noreply@jaya.tech
EMAIL_TO=contact@jaya.tech
